
import os
import sys
import pickle
import random

import pygame
import neat

pygame.font.init()

WIN_WIDTH = 600
WIN_HEIGHT = 800
FLOOR = 730            # y-positie van de grond
FPS = 100
SNELHEID = 5           # snelheid van pipes en base
PIPE_GAP = 160
BIRD_X = 230           # de vogel beweegt alleen omhoog en omlaag
BIRD_START_Y = 350

SCORE_DOEL = 1000      # training stopt bij dit aantal pipes (tijdens afstellen bv. 100)
MAX_GENERATIES = 150
TOON_SCHERM = False    # eigen wijziging: False = trainen zonder tekenen en klok (veel sneller)
RANDOM_SEED = None     # bijv. 1 om runs eerlijk te vergelijken
WINNER_BESTAND = "winner.pkl"

STAT_FONT = pygame.font.SysFont("comicsans", 50)
END_FONT = pygame.font.SysFont("comicsans", 70)

WIN = pygame.display.set_mode((WIN_WIDTH, WIN_HEIGHT))
pygame.display.set_caption("Flappy Bird")

pipe_img = pygame.transform.scale2x(pygame.image.load(os.path.join("imgs", "pipe.png")).convert_alpha())
bg_img = pygame.transform.scale(pygame.image.load(os.path.join("imgs", "bg.png")).convert_alpha(), (600, 900))
bird_images = [pygame.transform.scale2x(pygame.image.load(os.path.join("imgs", "bird" + str(x) + ".png"))) for x in range(1, 4)]
base_img = pygame.transform.scale2x(pygame.image.load(os.path.join("imgs", "base.png")).convert_alpha())

# Eigen wijziging: maskers eenmalig maken in plaats van elk frame (sneller trainen)
PIPE_TOP_IMG = pygame.transform.flip(pipe_img, False, True)
PIPE_BOTTOM_IMG = pipe_img
PIPE_TOP_MASK = pygame.mask.from_surface(PIPE_TOP_IMG)
PIPE_BOTTOM_MASK = pygame.mask.from_surface(PIPE_BOTTOM_IMG)
BIRD_MASKS = [pygame.mask.from_surface(img) for img in bird_images]

gen = 0  # generatieteller (alleen voor weergave)


class DoelBereikt(Exception):
    """Eigen wijziging: stopt de training zodra een vogel SCORE_DOEL pipes haalt."""
    def __init__(self, genome):
        super().__init__("Doelscore bereikt")
        self.genome = genome


class Bird:
    MAX_ROTATION = 25
    IMGS = bird_images
    ROT_VEL = 20
    ANIMATION_TIME = 5

    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.tilt = 0
        self.tick_count = 0
        self.vel = 0
        self.height = self.y
        self.img_count = 0
        self.img = self.IMGS[0]

    def jump(self):
        self.vel = -10.5
        self.tick_count = 0
        self.height = self.y

    def move(self):
        self.tick_count += 1
        displacement = self.vel * self.tick_count + 0.5 * 3 * self.tick_count ** 2

        if displacement >= 16:      # maximale valsnelheid
            displacement = 16
        if displacement < 0:
            displacement -= 2

        self.y = self.y + displacement

        if displacement < 0 or self.y < self.height + 50:
            if self.tilt < self.MAX_ROTATION:
                self.tilt = self.MAX_ROTATION
        else:
            if self.tilt > -90:
                self.tilt -= self.ROT_VEL

    def volgende_verplaatsing(self):
        """
        Eigen toevoeging: hoeveel pixels de vogel het volgende frame beweegt als hij niet
        springt (negatief = omhoog). Dit is de snelheid, de vierde invoer van het netwerk.
        """
        t = self.tick_count + 1
        displacement = self.vel * t + 0.5 * 3 * t ** 2
        if displacement >= 16:
            displacement = 16
        if displacement < 0:
            displacement -= 2
        return displacement

    def draw(self, win):
        self.img_count += 1

        if self.img_count <= self.ANIMATION_TIME:
            self.img = self.IMGS[0]
        elif self.img_count <= self.ANIMATION_TIME * 2:
            self.img = self.IMGS[1]
        elif self.img_count <= self.ANIMATION_TIME * 3:
            self.img = self.IMGS[2]
        elif self.img_count <= self.ANIMATION_TIME * 4:
            self.img = self.IMGS[1]
        elif self.img_count == self.ANIMATION_TIME * 4 + 1:
            self.img = self.IMGS[0]
            self.img_count = 0

        if self.tilt <= -80:        # bij duiken niet flapperen
            self.img = self.IMGS[1]
            self.img_count = self.ANIMATION_TIME * 2

        blitRotateCenter(win, self.img, (self.x, self.y), self.tilt)

    def get_mask(self):
        return BIRD_MASKS[self.IMGS.index(self.img)]


class Pipe:
    GAP = PIPE_GAP
    VEL = SNELHEID

    def __init__(self, x):
        self.x = x
        self.height = 0
        self.top = 0
        self.bottom = 0
        self.PIPE_TOP = PIPE_TOP_IMG
        self.PIPE_BOTTOM = PIPE_BOTTOM_IMG
        self.breedte = PIPE_TOP_IMG.get_width()
        self.passed = False
        self.set_height()

    def set_height(self):
        # height = onderkant van de bovenpijp, bottom = bovenkant van de onderpijp
        self.height = random.randrange(50, 450)
        self.top = self.height - self.PIPE_TOP.get_height()
        self.bottom = self.height + self.GAP

    def move(self):
        self.x -= self.VEL

    def draw(self, win):
        win.blit(self.PIPE_TOP, (self.x, self.top))
        win.blit(self.PIPE_BOTTOM, (self.x, self.bottom))

    def collide(self, bird):
        # snelle voorcontrole: horizontaal niet in de buurt = geen botsing
        if bird.x + bird.img.get_width() < self.x or bird.x > self.x + self.breedte:
            return False

        bird_mask = bird.get_mask()
        top_offset = (self.x - bird.x, self.top - round(bird.y))
        bottom_offset = (self.x - bird.x, self.bottom - round(bird.y))

        b_point = bird_mask.overlap(PIPE_BOTTOM_MASK, bottom_offset)
        t_point = bird_mask.overlap(PIPE_TOP_MASK, top_offset)
        return bool(b_point or t_point)


class Base:
    VEL = SNELHEID
    WIDTH = base_img.get_width()
    IMG = base_img

    def __init__(self, y):
        self.y = y
        self.x1 = 0
        self.x2 = self.WIDTH

    def move(self):
        self.x1 -= self.VEL
        self.x2 -= self.VEL
        if self.x1 + self.WIDTH < 0:
            self.x1 = self.x2 + self.WIDTH
        if self.x2 + self.WIDTH < 0:
            self.x2 = self.x1 + self.WIDTH

    def draw(self, win):
        win.blit(self.IMG, (self.x1, self.y))
        win.blit(self.IMG, (self.x2, self.y))


def blitRotateCenter(surf, image, topleft, angle):
    rotated_image = pygame.transform.rotate(image, angle)
    new_rect = rotated_image.get_rect(center=image.get_rect(topleft=topleft).center)
    surf.blit(rotated_image, new_rect.topleft)


def draw_window(win, birds, pipes, base, score, gen, toon_generatie=True):
    win.blit(bg_img, (0, 0))

    for pipe in pipes:
        pipe.draw(win)

    base.draw(win)
    for bird in birds:
        bird.draw(win)

    score_label = STAT_FONT.render("Score: " + str(score), 1, (255, 255, 255))
    win.blit(score_label, (WIN_WIDTH - score_label.get_width() - 15, 10))

    if toon_generatie:
        gen_label = STAT_FONT.render("Gens: " + str(gen), 1, (255, 255, 255))
        win.blit(gen_label, (10, 10))
        alive_label = STAT_FONT.render("Alive: " + str(len(birds)), 1, (255, 255, 255))
        win.blit(alive_label, (10, 50))

    pygame.display.update()


def dichtstbijzijnde_pipe(pipes):
    """Index van de pipe die de vogel nu moet nemen (de tweede als de eerste voorbij is)."""
    if len(pipes) > 1 and BIRD_X > pipes[0].x + pipes[0].breedte:
        return 1
    return 0


def netwerk_invoer(bird, pipe):
    """
    De vier invoeren van het netwerk (num_inputs = 4 in de config):
      1. hoogte van de vogel
      2. afstand tot de onderkant van de bovenpijp (met teken)
      3. afstand tot de bovenkant van de onderpijp (met teken)
      4. snelheid van de vogel
    Eigen wijziging: de tutorial gebruikte abs() en had geen snelheid. Bij een opening van
    160 pixels moet de vogel op het juiste moment springen; daarvoor moet het netwerk zien
    of de vogel stijgt of valt.
    """
    return (bird.y,
            bird.y - pipe.height,
            bird.y - pipe.bottom,
            bird.volgende_verplaatsing())


def eval_genomes(genomes, config):
    """
    Speelt een hele generatie: elk genome bestuurt een eigen vogel, alle vogels spelen
    tegelijk in hetzelfde spel. NEAT gebruikt de fitness die we hier uitrekenen om te
    bepalen welke vogels zich mogen voortplanten.

    FITNESS FUNCTION:
      * +0,1 per frame dat de vogel leeft: overleven wordt beloond.
      * +5 voor elke pipe die een levende vogel passeert: de hoofdbeloning, want het
        doel van het spel is door de openingen komen.
      * -1 als de vogel een pipe raakt: botsen wordt zwaarder gestraft dan sterven door
        de grond of het plafond, zodat vogels de opening leren zoeken.
    De vogel springt als de uitvoer van het netwerk groter is dan 0,5.
    De generatie stopt als alle vogels dood zijn, of gooit DoelBereikt op bij SCORE_DOEL.
    """
    global gen
    gen += 1

    nets = []
    birds = []
    ge = []

    for genome_id, genome in genomes:
        genome.fitness = 0
        nets.append(neat.nn.FeedForwardNetwork.create(genome, config))
        birds.append(Bird(BIRD_X, BIRD_START_Y))
        ge.append(genome)

    base = Base(FLOOR)
    pipes = [Pipe(700)]
    score = 0
    clock = pygame.time.Clock()

    while len(birds) > 0:
        if TOON_SCHERM:
            clock.tick(FPS)

        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit()
                sys.exit()

        pipe_ind = dichtstbijzijnde_pipe(pipes)

        # 1. elke levende vogel beslist en beweegt
        for i, bird in enumerate(birds):
            ge[i].fitness += 0.1
            bird.move()
            output = nets[i].activate(netwerk_invoer(bird, pipes[pipe_ind]))
            if output[0] > 0.5:
                bird.jump()

        base.move()

        # 2. pipes bewegen en botsingen controleren
        dood = set()  # indices van vogels die dit frame doodgaan
        rem = []
        add_pipe = False
        for pipe in pipes:
            pipe.move()

            for i, bird in enumerate(birds):
                if i not in dood and pipe.collide(bird):
                    ge[i].fitness -= 1
                    dood.add(i)

            if pipe.x + pipe.breedte < 0:
                rem.append(pipe)

            # bugfix: vaste BIRD_X i.p.v. de losse variabele 'bird' uit de tutorial
            if not pipe.passed and pipe.x < BIRD_X:
                pipe.passed = True
                add_pipe = True

        if add_pipe:
            score += 1
            for i, genome in enumerate(ge):
                if i not in dood:
                    genome.fitness += 5
            pipes.append(Pipe(WIN_WIDTH))

        for r in rem:
            pipes.remove(r)

        # 3. grond of plafond geraakt
        for i, bird in enumerate(birds):
            if bird.y + bird.img.get_height() - 10 >= FLOOR or bird.y < -50:
                dood.add(i)

        # 4. dode vogels pas nu uit de lijsten halen (bugfix: niet tijdens het lopen erover)
        if dood:
            nets = [n for i, n in enumerate(nets) if i not in dood]
            ge = [g for i, g in enumerate(ge) if i not in dood]
            birds = [b for i, b in enumerate(birds) if i not in dood]

        # 5. doelscore bereikt: een levende vogel is de winnaar
        if score >= SCORE_DOEL and len(ge) > 0:
            raise DoelBereikt(ge[0])

        if TOON_SCHERM:
            draw_window(WIN, birds, pipes, base, score, gen)


def laad_config(config_file):
    return neat.config.Config(neat.DefaultGenome, neat.DefaultReproduction,
                              neat.DefaultSpeciesSet, neat.DefaultStagnation,
                              config_file)


def run(config_file):
    """Traint met NEAT en bewaart het beste vogeltje met pickle."""
    config = laad_config(config_file)

    if not TOON_SCHERM:
        print("Trainen zonder scherm: het venster blijft leeg, de voortgang staat in de Shell.")

    p = neat.Population(config)
    p.add_reporter(neat.StdOutReporter(True))
    p.add_reporter(neat.StatisticsReporter())

    try:
        winner = p.run(eval_genomes, MAX_GENERATIES)
        print("\nMaximaal aantal generaties bereikt zonder doelscore; beste genome wordt gebruikt.")
    except DoelBereikt as klaar:
        winner = klaar.genome
        print("\nDoelscore van " + str(SCORE_DOEL) + " bereikt in generatie " + str(gen) + "!")

    print("\nBest genome:\n{!s}".format(winner))

    # eigen toevoeging: het beste vogeltje bewaren met pickle voor het eindspel
    with open(WINNER_BESTAND, "wb") as f:
        pickle.dump(winner, f)
    print("Winnaar opgeslagen in " + WINNER_BESTAND)

    return winner


def speel_met_beste_vogel(config_file, genome=None):
    """
    Eindspel: alleen het beste vogeltje speelt, op 100 fps en zonder scorelimiet.
    Stopt als de vogel doodgaat of het venster wordt gesloten.
    """
    config = laad_config(config_file)

    if genome is None:
        with open(WINNER_BESTAND, "rb") as f:
            genome = pickle.load(f)

    net = neat.nn.FeedForwardNetwork.create(genome, config)

    bird = Bird(BIRD_X, BIRD_START_Y)
    base = Base(FLOOR)
    pipes = [Pipe(700)]
    score = 0
    clock = pygame.time.Clock()

    while True:
        clock.tick(FPS)

        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit()
                sys.exit()

        pipe_ind = dichtstbijzijnde_pipe(pipes)

        bird.move()
        output = net.activate(netwerk_invoer(bird, pipes[pipe_ind]))
        if output[0] > 0.5:
            bird.jump()

        base.move()

        add_pipe = False
        rem = []
        geraakt = False
        for pipe in pipes:
            pipe.move()
            if pipe.collide(bird):
                geraakt = True
            if pipe.x + pipe.breedte < 0:
                rem.append(pipe)
            if not pipe.passed and pipe.x < BIRD_X:
                pipe.passed = True
                add_pipe = True

        if add_pipe:
            score += 1
            pipes.append(Pipe(WIN_WIDTH))

        for r in rem:
            pipes.remove(r)

        if geraakt or bird.y + bird.img.get_height() - 10 >= FLOOR or bird.y < -50:
            break

        draw_window(WIN, [bird], pipes, base, score, 0, toon_generatie=False)

    print("Eindspel afgelopen met score: " + str(score))
    eind_label = END_FONT.render("Score: " + str(score), 1, (255, 255, 255))
    WIN.blit(eind_label, (WIN_WIDTH / 2 - eind_label.get_width() / 2, 350))
    pygame.display.update()
    pygame.time.wait(3000)


if __name__ == '__main__':
    if RANDOM_SEED is not None:
        random.seed(RANDOM_SEED)

    local_dir = os.path.dirname(os.path.abspath(__file__))
    config_path = os.path.join(local_dir, 'config-feedforward.txt')

    if len(sys.argv) > 1 and sys.argv[1] == "speel":
        speel_met_beste_vogel(config_path)
    else:
        winner = run(config_path)
        speel_met_beste_vogel(config_path, winner)

    pygame.quit()
